{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/main-server",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/main-server/tsconfig.app.json",
    "deleteOutDir": false
  },
  "projects": {
    "main-server": {
      "type": "application",
      "root": "apps/main-server",
      "entryFile": "main",
      "sourceRoot": "apps/main-server/src",
      "compilerOptions": {
        "tsConfigPath": "apps/main-server/tsconfig.app.json"
      }
    },
    "shipping-service": {
      "type": "application",
      "root": "apps/shipping-service",
      "entryFile": "main",
      "sourceRoot": "apps/shipping-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shipping-service/tsconfig.app.json"
      }
    }
  }
}